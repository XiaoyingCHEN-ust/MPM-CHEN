			"poisson_ratio": 0.4,
			"youngs_modulus": 10E6,
			"porosity": 0.3,
			"k_x": 5E-4,
			"k_y": 5E-4,
      "theta": 0,
			"intrinsic_permeability": 5E-11,
			"thermal_expansivity": 1E-5,
			"thermal_conductivity":100E3,
			"specific_heat": 880,
			"density_ratio":0,
