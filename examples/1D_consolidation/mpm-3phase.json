			"beta": 1,
			"free_surface_particle": "assign",
			"integration": "mp",
			"penalty_factor": -1
		},
        "damping": {
			"type": "Cundall",
			"damping_factor": 0
		},
		"pressure_smoothing": false,
		"uuid": "3phase-Sh=0.7-pc=200E3-pg=const-T",
		"gravity": [0.0, 0.0],
		"/variable_timestep":true,
		"dt": 1E-6,
		"nsteps": 1E6,
		"/nsteps": 3,
		"dt_matrix" : [1E-6, 1E-5, 1E-4],
		"nsteps_matrix" : [1E3, 2E3, 1E6],
		"/matrix": {
			"max_iter": 10000,
			"tolerance": 1E-8,
			"volume_tolerance": 0.25,
			"assembler_type": "EigenSemiImplicitTwoPhase2D",
			"solver_type": "EigenCG2D",
			"num_threads": 4,
			"entries_number":{
				"K_matrix": 100,
				"L_matrix": 100,
				"F_matrix": 100,
				"N_matrix": 100,
				"T_matrix": 100,
				"K_cor_matrix": 200
			}
		}
	},
	"post_processing": {
		"path": "results/",
