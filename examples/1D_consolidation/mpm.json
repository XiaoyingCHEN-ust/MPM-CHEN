				"F_matrix": 100,
                "N_matrix": 100,
				"T_matrix": 100,
				"K_cor_matrix": 200
			}
		}
	},
	"post_processing": {
		"path": "results/",
		"write_hdf5":false,
		"write_vtk":true,
		"vtk": ["displacements",
			    "velocities",
			    "stresses",
